# ── Microsoft Entra ID / Azure App Registration ──────────────────────────────
# Found in Azure Portal → Entra ID → App Registrations → Your App → Overview
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here

# Found in Azure Portal → App Registration → Certificates & Secrets
# Copy the VALUE (not the secret ID) immediately after creating it
AZURE_CLIENT_SECRET=your-client-secret-here

# ── App Config ────────────────────────────────────────────────────────────────
PORT=3000
COMPANY_NAME=WireStar Networks
COMPANY_WEBSITE=https://wirestar.net
SIGNATURE_ACCENT_COLOR=#500000
